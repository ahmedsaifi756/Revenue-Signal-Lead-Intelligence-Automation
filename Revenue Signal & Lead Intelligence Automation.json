    {
      "parameters": {
        "jsCode": "// ─── Step 1: Gemini ka text nikaalo ───\nconst gemini = $json;\nconst rawText = gemini?.content?.parts?.[0]?.text;\nconst account = $('Webhook').item.json.body;\n\n// ─── Step 2: Text ko JSON mein parse karo ───\nlet ai;\ntry {\n  const cleaned = String(rawText || \"\")\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n  ai = JSON.parse(cleaned);\n} catch (e) {\n  ai = {};\n}\n\n// ─── Step 3: Signals normalize karo ───\nconst allowed = [\"LOW\", \"MEDIUM\", \"HIGH\", \"UNKNOWN\"];\n\nfunction normalizeSignal(value) {\n  const signal = String(value ?? \"UNKNOWN\").toUpperCase();\n  return allowed.includes(signal) ? signal : \"UNKNOWN\";\n}\n\nconst confidence = Number(ai.confidence);\n\nreturn [{\n  json: {\n    event_id: account.event_id, \n    event_type : account.event_type,\n    account_id: account.account_id,\n    account_name: account.account_name,\n\n    engagement_signal: normalizeSignal(ai.engagement_signal),\n    renewal_signal:    normalizeSignal(ai.renewal_signal),\n    expansion_signal:  normalizeSignal(ai.expansion_signal),\n    risk_signal:       normalizeSignal(ai.risk_signal),\n\n    confidence: Number.isFinite(confidence)\n      ? Math.min(Math.max(confidence, 0), 1)\n      : 0,\n\n    reasoning: Array.isArray(ai.reasoning) ? ai.reasoning : []\n  }\n}];"
      },
