    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════\n// STEP 1: SIGNAL SCORING (ganna)\n// ═══════════════════════════════════════════\nconst data = $json;\n\nconst signalValue = {\n  HIGH: 1,\n  MEDIUM: 0.5,\n  LOW: 0,\n  UNKNOWN: 0\n};\n\nconst weights = {\n  engagement_signal: 25,\n  renewal_signal: 30,\n  expansion_signal: 30,\n  risk_signal: 15\n};\n\nfunction calculateSignal(signal, weight) {\n  return (signalValue[signal] ?? 0) * weight;\n}\n\nconst engagementScore = calculateSignal(data.engagement_signal, weights.engagement_signal);\nconst renewalScore    = calculateSignal(data.renewal_signal,    weights.renewal_signal);\nconst expansionScore  = calculateSignal(data.expansion_signal,  weights.expansion_signal);\nconst riskScore       = calculateSignal(data.risk_signal,       weights.risk_signal);\n\nconst totalScore = engagementScore + renewalScore + expansionScore + riskScore;\n\n// ═══════════════════════════════════════════\n// STEP 2: PRIORITY DECISION (business rule)\n// ═══════════════════════════════════════════\nlet priority;\nif (totalScore >= 70) {\n  priority = \"HIGH\";\n} else if (totalScore >= 40) {\n  priority = \"MEDIUM\";\n} else {\n  priority = \"LOW\";\n}\n\n// ═══════════════════════════════════════════\n// OUTPUT\n// ═══════════════════════════════════════════\nreturn [{\n  json: {\n    ...data,\n    engagement_score: engagementScore,\n    renewal_score: renewalScore,\n    expansion_score: expansionScore,\n    risk_score: riskScore,\n    total_signal_score: totalScore,\n    priority\n  }\n}];"
      },
