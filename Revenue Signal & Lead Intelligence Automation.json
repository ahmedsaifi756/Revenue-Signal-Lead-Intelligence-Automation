        "messages": {
          "values": [
            {
              "content": "=You are a business signal extraction system.\n\nAnalyze the customer/account activity provided by the user.\n\nExtract only these business signals:\n\n1. engagement_signal\n2. renewal_signal\n3. expansion_signal\n4. risk_signal\n\nAllowed values:\nLOW\nMEDIUM\nHIGH\nUNKNOWN\n\nAlso return:\n- confidence: number between 0 and 1\n- reasoning: short list explaining the extracted signals\n\nImportant rules:\n- Do not assign an overall priority.\n- Do not recommend an action.\n- Do not invent facts.\n- If evidence is insufficient, use UNKNOWN.\n- Return valid JSON only.\n\n{{ $json.body.account_name }}\n{{$json.body.event_text}}\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        288,
        128
      ],
      "id": "ID",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
